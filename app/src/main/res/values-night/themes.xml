<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.MyApplication" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/bs_secondary</item>
        <item name="android:statusBarColor">@color/bs_dark_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/bs_dark_bg</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/bs_secondary</item>
        <item name="materialCardViewStyle">@style/Widget.Bootstrap.Card</item>
        <item name="cardViewStyle">@style/Widget.Bootstrap.Card</item>
        <item name="alertDialogTheme">@style/Theme.MyApplication.Dialog</item>
    </style>

    <!-- Blue Variants -->
    <style name="Theme_MyApplication_Blue_Light" parent="Base.Theme.MyApplication">
        <item name="colorPrimary">@color/accent_blue_light</item>
        <item name="colorOnPrimary">@color/black</item>
    </style>
    <style name="Theme_MyApplication_Blue" parent="Base.Theme.MyApplication">
        <item name="colorPrimary">@color/accent_blue</item>
        <item name="colorOnPrimary">@color/white</item>
    </style>
