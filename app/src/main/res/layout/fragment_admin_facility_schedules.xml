<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <!-- Fixed Header Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingTop="20dp"
        android:paddingRight="20dp"
        android:paddingBottom="12dp">

        <!-- Top Header with Back Button, Category Subtitle & Main Title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageButton
                android:id="@+id/btnBackList"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_input_field"
                android:src="@drawable/ic_back"
                app:tint="?android:attr/textColorPrimary"
                android:layout_marginEnd="12dp"
                android:contentDescription="Atrás" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ESPACIOS ACADÉMICOS"
                    android:textColor="#38BDF8"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvHeaderTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gestión de la Instalación"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Top Facility Hero Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/input_bg"
            app:strokeWidth="1dp"
            app:strokeColor="@color/input_border">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <!-- Top Row: Type Pill Badge -->
                <TextView
                    android:id="@+id/tvFacilityTypePill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AULA MAGNA"
                    android:textColor="#38BDF8"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:background="@drawable/bg_badge_semester"
                    tools:text="AULA MAGNA" />

                <!-- Facility Name -->
                <TextView
                    android:id="@+id/tvFacilityName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Aula Magna A-1"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginTop="6dp"
                    tools:text="Aula Magna A-1" />

                <!-- Facility Description -->
                <TextView
                    android:id="@+id/tvFacilityDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Aulas • Edificio Central, 1º Nivel. Capacidad para 40 alumnos con proyector multimedia."
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="12sp"
                    android:layout_marginTop="3dp"
                    android:layout_marginBottom="12dp"
                    tools:text="Aulas • Edificio Central, 1º Nivel. Capacidad para 40 alumnos con proyector multimedia." />

                <!-- Action Buttons inside Card: Horario & Detalle -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnViewTimetable"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="38dp"
                        android:layout_marginEnd="4dp"
                        android:text="Horario"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textAllCaps="false"
                        app:icon="@drawable/ic_timetable"
                        app:iconGravity="textStart"
                        app:iconSize="16dp"
                        app:iconTint="#38BDF8"
                        app:cornerRadius="10dp"
                        app:strokeColor="@color/input_border"
                        app:strokeWidth="1dp"
                        android:backgroundTint="@color/input_bg" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnHeaderDetail"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="38dp"
                        android:layout_marginStart="4dp"
                        android:text="Detalle"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textAllCaps="false"
                        app:icon="@drawable/ic_building"
                        app:iconGravity="textStart"
                        app:iconSize="16dp"
                        app:iconTint="#38BDF8"
                        app:cornerRadius="10dp"
                        app:strokeColor="@color/input_border"
                        app:strokeWidth="1dp"
                        android:backgroundTint="@color/input_bg" />
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Top Action Row: Programar Button + Search Toggle Button on Right -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <!-- Primary Action Button: + Programar Clase -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAdd"
                style="@style/Widget.Bootstrap.Button.Primary"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp"
                android:text="+ Programar Clase"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:backgroundTint="?attr/colorPrimary"
                app:elevation="0dp" />

            <!-- Search Toggle ImageButton -->
            <ImageButton
                android:id="@+id/btnToggleSearch"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_input_field"
                android:src="@drawable/ic_search"
                app:tint="?attr/colorPrimary"
                android:contentDescription="Alternar búsqueda" />
        </LinearLayout>

        <!-- Search and Filter Bar (Collapsible / Toggleable) -->
        <LinearLayout
            android:id="@+id/layoutSearchContainer"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_input_field"
            android:paddingHorizontal="14dp"
            android:layout_marginBottom="8dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_search"
                app:tint="?android:attr/textColorSecondary"
                android:contentDescription="Buscar"
                android:layout_marginEnd="8dp" />

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="Buscar horario o materia..."
                android:textSize="13sp"
                android:textColor="?android:attr/textColorPrimary"
                android:textColorHint="?android:attr/textColorSecondary"
                android:singleLine="true" />

            <Spinner
                android:id="@+id/spinnerFilter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="?attr/colorPrimary" />
        </LinearLayout>

        <!-- Schedule Section Header (Count + Semanal Badge) -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tvRecordCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="0 horarios programados"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="12sp"
                tools:text="2 horarios programados" />

            <TextView
                android:id="@+id/tvWeeklyBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="🗓️ Semanal"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </RelativeLayout>
    </LinearLayout>

    <!-- Scrollable RecyclerView for Class Schedules Only -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="20dp"
        android:paddingTop="4dp"
        android:paddingBottom="80dp"
        android:clipToPadding="false" />

</LinearLayout>
