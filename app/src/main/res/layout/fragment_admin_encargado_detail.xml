<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingTop="20dp"
        android:paddingRight="20dp"
        android:paddingBottom="80dp">

        <!-- Top Header with Back Button and Title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageButton
                android:id="@+id/btnBackEncargadoDetail"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_input_field"
                android:src="@drawable/ic_back"
                app:tint="?android:attr/textColorPrimary"
                android:layout_marginEnd="12dp"
                android:contentDescription="Atrás" />

            <TextView
                android:id="@+id/tvDetailTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gestión del encargado"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Encargado Summary Card (Top Card) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/input_bg"
            app:strokeWidth="1dp"
            app:strokeColor="@color/input_border">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <FrameLayout
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_circle_primary"
                        android:layout_marginEnd="12dp">

                        <TextView
                            android:id="@+id/tvEncargadoInitials"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            tools:text="BM"
                            android:textColor="@color/white"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Encargado"
                            android:textColor="@color/accent_orange"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvEncargadoName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Bryan Antonio Madrid Cortez"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:layout_marginTop="2dp"
                            tools:text="Bryan Antonio Madrid Cortez" />

                        <TextView
                            android:id="@+id/tvEncargadoCarnet"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ENC1444444"
                            android:textColor="@color/accent_orange"
                            android:textSize="13sp"
                            android:layout_marginTop="2dp"
                            tools:text="ENC1444444" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Detalle Button inside card -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnHeaderDetail"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="Detalle"
                    android:textColor="@color/accent_orange"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    app:icon="@drawable/ic_person_badge"
                    app:iconGravity="textStart"
                    app:iconSize="18dp"
                    app:iconTint="@color/accent_orange"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/input_border"
                    app:strokeWidth="1dp"
                    android:backgroundTint="@color/input_bg" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Alumnos a cargo Section Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Alumnos a cargo"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Consulta y gestiona los estudiantes del encargado."
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="14sp"
            android:layout_marginBottom="16dp" />

        <!-- Top Action Row: Add Button + Search Toggle Button on Right -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <!-- Primary Action Button: Añadir alumno a cargo -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddStudentToEncargado"
                style="@style/Widget.Bootstrap.Button.Primary"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="52dp"
                android:text="+ Añadir alumno a cargo"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:backgroundTint="?attr/colorPrimary"
                app:elevation="0dp" />

            <!-- Search Toggle ImageButton -->
            <ImageButton
                android:id="@+id/btnToggleSearch"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_input_field"
                android:src="@drawable/ic_search"
                app:tint="?attr/colorPrimary"
                android:contentDescription="Alternar búsqueda" />
        </LinearLayout>

        <!-- Search and Filter Bar (Collapsible / Toggleable) -->
        <LinearLayout
            android:id="@+id/layoutSearchContainer"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_input_field"
            android:paddingHorizontal="14dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_search"
                app:tint="?android:attr/textColorSecondary"
                android:contentDescription="Buscar"
                android:layout_marginEnd="8dp"/>

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="Buscar..."
                android:textSize="14sp"
                android:textColor="?android:attr/textColorPrimary"
                android:textColorHint="?android:attr/textColorSecondary"
                android:singleLine="true" />

            <Spinner
                android:id="@+id/spinnerFilter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="?attr/colorPrimary" />
        </LinearLayout>

        <!-- Record Count Counter -->
        <TextView
            android:id="@+id/tvRecordCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1 alumno"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="13sp"
            android:layout_marginBottom="12dp" />

        <!-- RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

        <TextView
            android:id="@+id/tvNoStudentsMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Este encargado aún no tiene estudiantes asignados."
            android:textAlignment="center"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="14sp"
            android:padding="24dp"
            android:visibility="gone"/>

    </LinearLayout>
</ScrollView>
