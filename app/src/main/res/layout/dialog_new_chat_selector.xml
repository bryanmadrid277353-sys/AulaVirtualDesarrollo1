<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/input_bg"
        app:strokeWidth="1dp"
        app:strokeColor="@color/input_border">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Top Header: Title + Subtitle + Close Button (X) -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_alignParentStart="true"
                    android:layout_toStartOf="@id/btnCloseNewChatDialog"
                    android:layout_marginEnd="12dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Nuevo Chat"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/bg_circle_primary"
                            android:layout_marginStart="6dp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Selecciona un usuario para iniciar un chat privado directo."
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="13sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnCloseNewChatDialog"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentTop="true"
                    android:background="@drawable/bg_input_field"
                    android:src="@drawable/ic_close"
                    app:tint="?android:attr/textColorSecondary"
                    android:contentDescription="Cerrar" />
            </RelativeLayout>

            <!-- Search Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_input_field"
                android:paddingHorizontal="14dp"
                android:layout_marginBottom="14dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_search"
                    app:tint="?android:attr/textColorSecondary"
                    android:contentDescription="Buscar"
                    android:layout_marginEnd="10dp"/>

                <EditText
                    android:id="@+id/etSearchNewChat"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:hint="Buscar por nombre, carnet o rol..."
                    android:textSize="13sp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textColorHint="?android:attr/textColorSecondary"
                    android:singleLine="true" />
            </LinearLayout>

            <!-- Filter Chips Row -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:overScrollMode="never"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:id="@+id/chipsNewChatLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- Scrollable Contacts RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvNewChatContacts"
                android:layout_width="match_parent"
                android:layout_height="320dp"
                android:clipToPadding="false" />

            <TextView
                android:id="@+id/tvEmptyNewChatContacts"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:gravity="center"
                android:text="No se encontraron usuarios disponibles."
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="13sp"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>
</ScrollView>
