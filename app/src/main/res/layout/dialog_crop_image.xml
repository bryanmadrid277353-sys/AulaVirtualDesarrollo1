<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/input_bg"
        app:strokeWidth="1dp"
        app:strokeColor="@color/input_border">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Title -->
            <TextView
                android:id="@+id/tvCropTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ajustar Foto de Perfil"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- Subtitle -->
            <TextView
                android:id="@+id/tvCropSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Arrastre y pellizca la imagen para mover y hacer zoom"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="14sp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="20dp" />

            <!-- Crop Area -->
            <com.aula.virtual.ui.CropImageView
                android:id="@+id/cropImageView"
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:background="#000000" />

            <!-- Rotate Button Centered Below Crop Image View -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRotate90"
                style="@style/Widget.Material3.Button.OutlinedButton.Icon"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="20dp"
                android:text="Rotar"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:paddingHorizontal="20dp"
                app:icon="@drawable/ic_rotate_wheel"
                app:iconTint="?android:attr/textColorPrimary"
                app:cornerRadius="12dp"
                app:strokeColor="@color/input_border"
                app:strokeWidth="1dp"
                android:backgroundTint="@color/input_bg" />

            <!-- Bottom Action Buttons: Cancelar / Guardar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCropCancel"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="Cancelar"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/input_border"
                    app:strokeWidth="1dp"
                    android:backgroundTint="@color/input_bg" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCropSave"
                    style="@style/Widget.Bootstrap.Button.Primary"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Guardar"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    app:cornerRadius="12dp"
                    app:backgroundTint="#2563EB"
                    app:elevation="0dp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>
</ScrollView>