<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Header with Back Button, Title and Active Status Badge -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp">

            <ImageButton
                android:id="@+id/btnBackDetail"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_input_field"
                android:src="@drawable/ic_back"
                app:tint="?android:attr/textColorPrimary"
                android:contentDescription="Atrás" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/btnBackDetail"
                android:layout_centerVertical="true"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDetailTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Detalle Materia"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDetailSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gestión de asignatura y aula"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </RelativeLayout>



        <!-- General Information Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardFormContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/input_bg"
            app:strokeWidth="1dp"
            app:strokeColor="@color/input_border">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Field 1: Nombre completo -->
                <TextView
                    android:id="@+id/tvLabelField1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nombre completo"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">

                    <EditText
                        android:id="@+id/etField1"
                        style="@style/Widget.Bootstrap.EditText"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="Nombre de la Materia"
                        android:paddingEnd="44dp"
                        android:singleLine="true"/>

                    <ImageButton
                        android:id="@+id/btnCopyField1"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_input_field"
                        android:src="@drawable/ic_copy"
                        app:tint="?attr/colorPrimary"
                        android:contentDescription="Copiar"/>
                </RelativeLayout>

                <!-- Field 2: Carnet / ID Materia -->
                <TextView
                    android:id="@+id/tvLabelField2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Carnet / ID Materia"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_input_field"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="14dp"
                        android:paddingEnd="44dp">

                        <TextView
                            android:id="@+id/tvCodePrefix"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ASIGN "
                            android:textColor="@color/accent_cyan"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:layout_marginEnd="4dp" />

                        <EditText
                            android:id="@+id/etField2"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@null"
                            android:hint="10001"
                            android:inputType="number"
                            android:maxLength="5"
                            android:singleLine="true"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textColorHint="@color/input_hint"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/btnCopyField2"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_input_field"
                        android:src="@drawable/ic_copy"
                        app:tint="?attr/colorPrimary"
                        android:contentDescription="Copiar"/>
                </RelativeLayout>

                <!-- Field 3: Descripción de la materia (Debajo del ID) -->
                <TextView
                    android:id="@+id/tvLabelDescription"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Descripción de la materia"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">

                    <EditText
                        android:id="@+id/etDesc"
                        style="@style/Widget.Bootstrap.EditText"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:hint="Contenido o resumen del curso"
                        android:gravity="top|start"
                        android:inputType="textMultiLine"
                        android:paddingEnd="44dp" />

                    <ImageButton
                        android:id="@+id/btnCopyDesc"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_input_field"
                        android:src="@drawable/ic_copy"
                        app:tint="?attr/colorPrimary"
                        android:contentDescription="Copiar"/>
                </RelativeLayout>

                <!-- Field 3: Sección asignada -->
                <TextView
                    android:id="@+id/tvLabelField4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sección asignada"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/etField4"
                    style="@style/Widget.Bootstrap.EditText"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="Número de sección (1 al 9)"
                    android:inputType="number"
                    android:maxLength="1"
                    android:singleLine="true"/>



                <!-- Student Grades Container -->
                <LinearLayout
                    android:id="@+id/layoutStudentGrades"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="16dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Calificaciones"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="?android:attr/textColorPrimary"
                        android:layout_marginBottom="12dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="P1" android:textSize="12sp" android:textColor="?android:attr/textColorSecondary"/>
                            <TextView android:id="@+id/tvDetailP1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" android:textSize="16sp" android:textColor="?android:attr/textColorPrimary"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="P2" android:textSize="12sp" android:textColor="?android:attr/textColorSecondary"/>
                            <TextView android:id="@+id/tvDetailP2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" android:textSize="16sp" android:textColor="?android:attr/textColorPrimary"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="P3" android:textSize="12sp" android:textColor="?android:attr/textColorSecondary"/>
                            <TextView android:id="@+id/tvDetailP3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" android:textSize="16sp" android:textColor="?android:attr/textColorPrimary"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="P4" android:textSize="12sp" android:textColor="?android:attr/textColorSecondary"/>
                            <TextView android:id="@+id/tvDetailP4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" android:textSize="16sp" android:textColor="?android:attr/textColorPrimary"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="P5" android:textSize="12sp" android:textColor="?android:attr/textColorSecondary"/>
                            <TextView android:id="@+id/tvDetailP5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" android:textSize="16sp" android:textColor="?android:attr/textColorPrimary"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AVG" android:textSize="12sp" android:textStyle="bold" android:textColor="?attr/colorPrimary"/>
                            <TextView android:id="@+id/tvDetailAverage" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="N/A" android:textSize="16sp" android:textStyle="bold" android:textColor="?attr/colorPrimary"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Color Selector Container -->
                <LinearLayout
                    android:id="@+id/layoutColorSelector"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="16dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvColorLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Color Materia"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="?android:attr/textColorPrimary"
                        android:layout_marginBottom="12dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginBottom="8dp">
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnColor1" style="@style/Widget.Bootstrap.ColorButton" android:backgroundTint="@color/accent_blue_light" android:layout_marginHorizontal="4dp"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnColor2" style="@style/Widget.Bootstrap.ColorButton" android:backgroundTint="@color/accent_red_light" android:layout_marginHorizontal="4dp"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnColor3" style="@style/Widget.Bootstrap.ColorButton" android:backgroundTint="@color/accent_green_light" android:layout_marginHorizontal="4dp"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnColor4" style="@style/Widget.Bootstrap.ColorButton" android:backgroundTint="@color/accent_purple_light" android:layout_marginHorizontal="4dp"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnColor5" style="@style/Widget.Bootstrap.ColorButton" android:backgroundTint="@color/accent_cyan_light" android:layout_marginHorizontal="4dp"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnColor6" style="@style/Widget.Bootstrap.ColorButton" android:backgroundTint="@color/accent_yellow_light" android:layout_marginHorizontal="4dp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_marginBottom="8dp">
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnColor7" style="@style/Widget.Bootstrap.ColorButton" android:backgroundTint="@color/accent_blue" android:layout_marginHorizontal="4dp"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnColor8" style="@style/Widget.Bootstrap.ColorButton" android:backgroundTint="@color/accent_red" android:layout_marginHorizontal="4dp"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnColor9" style="@style/Widget.Bootstrap.ColorButton" android:backgroundTint="@color/accent_green" android:layout_marginHorizontal="4dp"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnColor10" style="@style/Widget.Bootstrap.ColorButton" android:backgroundTint="@color/accent_purple" android:layout_marginHorizontal="4dp"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnColor11" style="@style/Widget.Bootstrap.ColorButton" android:backgroundTint="@color/accent_cyan" android:layout_marginHorizontal="4dp"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnColor12" style="@style/Widget.Bootstrap.ColorButton" android:backgroundTint="@color/accent_yellow" android:layout_marginHorizontal="4dp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center">
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnColor13" style="@style/Widget.Bootstrap.ColorButton" android:backgroundTint="@color/accent_blue_dark" android:layout_marginHorizontal="4dp"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnColor14" style="@style/Widget.Bootstrap.ColorButton" android:backgroundTint="@color/accent_red_dark" android:layout_marginHorizontal="4dp"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnColor15" style="@style/Widget.Bootstrap.ColorButton" android:backgroundTint="@color/accent_green_dark" android:layout_marginHorizontal="4dp"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnColor16" style="@style/Widget.Bootstrap.ColorButton" android:backgroundTint="@color/accent_purple_dark" android:layout_marginHorizontal="4dp"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnColor17" style="@style/Widget.Bootstrap.ColorButton" android:backgroundTint="@color/accent_cyan_dark" android:layout_marginHorizontal="4dp"/>
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnColor18" style="@style/Widget.Bootstrap.ColorButton" android:backgroundTint="@color/accent_yellow_dark" android:layout_marginHorizontal="4dp"/>
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Action Buttons Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <!-- Row 1: Guardar Cambios & Eliminar registro -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSave"
                    style="@style/Widget.Bootstrap.Button.Primary"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="Guardar Cambios"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    app:icon="@drawable/ic_copy"
                    app:iconGravity="textStart"
                    app:iconSize="18dp"
                    app:cornerRadius="12dp"
                    app:elevation="0dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDelete"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="Eliminar registro"
                    android:textColor="#FF6B6B"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    app:icon="@drawable/ic_delete"
                    app:iconGravity="textStart"
                    app:iconSize="18dp"
                    app:iconTint="#FF6B6B"
                    app:cornerRadius="12dp"
                    app:strokeColor="#52242B"
                    app:strokeWidth="1dp"
                    android:backgroundTint="@color/input_bg"/>
            </LinearLayout>

            <!-- Full-width Button: Desinscribir Integrante -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUnenrollMember"
                style="@style/Widget.Bootstrap.Button.Danger"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Desinscribir Integrante"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                app:icon="@drawable/ic_person"
                app:iconGravity="textStart"
                app:iconSize="18dp"
                app:iconTint="@color/white"
                app:cornerRadius="12dp"
                app:elevation="0dp"
                android:visibility="gone"
                tools:visibility="visible"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnManageStudents"
                style="@style/Widget.Bootstrap.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:text="Alumnos y Notas"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                app:cornerRadius="12dp"
                app:elevation="0dp"
                android:visibility="gone"/>
        </LinearLayout>

        <!-- Footer modification timestamp -->
        <TextView
            android:id="@+id/tvLastModifiedFooter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            tools:text="Última modificación: Hoy a las 08:33 por Admin Maestro"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp" />

    </LinearLayout>
</ScrollView>
