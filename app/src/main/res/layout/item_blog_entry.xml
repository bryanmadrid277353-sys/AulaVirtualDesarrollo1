<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/input_bg"
    app:strokeWidth="1dp"
    app:strokeColor="@color/input_border">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Category Badge Pill -->
        <TextView
            android:id="@+id/tvCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_semester"
            android:paddingHorizontal="14dp"
            android:paddingVertical="4dp"
            android:textColor="#38BDF8"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="Info" />

        <!-- Title Row (Drag Handle + Title) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="10dp">

            <ImageView
                android:id="@+id/ivDragHandle"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_drag_handle"
                app:tint="?android:attr/textColorSecondary"
                android:layout_marginEnd="10dp"
                android:visibility="gone"
                tools:visibility="visible"
                android:contentDescription="Reordenar" />

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="Horario de Consultas y Asesorías Académicas" />
        </LinearLayout>

        <!-- Content Body -->
        <TextView
            android:id="@+id/tvContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="14sp"
            android:layout_marginTop="8dp"
            tools:text="Las asesorías académicas de Matemáticas se realizarán en la Biblioteca los días miércoles de 1:00 PM a 2:00 PM." />

        <TextView
            android:id="@+id/btnReadMore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ver más"
            android:textColor="?attr/colorPrimary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginTop="6dp"
            android:visibility="gone" />

        <!-- Bottom Action Bar (Discusión, Editar, Eliminar) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical|end">

            <!-- Discusión Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDiscussion"
                style="@style/Widget.Bootstrap.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="Discusión"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:paddingHorizontal="16dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_chat"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconSize="18dp"
                app:iconTint="@color/white"
                app:backgroundTint="?attr/colorPrimary"
                app:elevation="0dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="Discusión" />

            <!-- Admin Actions: Edit & Delete -->
            <LinearLayout
                android:id="@+id/layoutAdminActions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEdit"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_edit"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="18dp"
                    app:iconTint="@color/white"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/input_border"
                    android:backgroundTint="@color/input_bg"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="Editar entrada" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDelete"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_delete"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="18dp"
                    app:iconTint="@color/white"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/input_border"
                    android:backgroundTint="@color/input_bg"
                    android:contentDescription="Eliminar entrada" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
