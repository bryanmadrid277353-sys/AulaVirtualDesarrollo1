<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/input_bg"
    app:strokeWidth="1dp"
    app:strokeColor="@color/input_border">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="12dp">

        <!-- Left: Badge & Name -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@id/layoutInputRight">

            <FrameLayout
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_badge_primary"
                android:layout_marginEnd="10dp">

                <TextView
                    android:id="@+id/tvPeriodBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="P1"
                    android:textColor="#38BDF8"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="P1" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvPeriodName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Primer Parcial"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="Primer Parcial" />
        </LinearLayout>

        <!-- Right: Input & Scale /10 -->
        <LinearLayout
            android:id="@+id/layoutInputRight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/etPeriodGrade"
                android:layout_width="72dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_input_field"
                android:gravity="center"
                android:hint="-"
                android:inputType="numberDecimal"
                android:maxLength="4"
                android:singleLine="true"
                android:textColor="@color/white"
                android:textColorHint="@color/input_hint"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="8.5" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" /10"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="13sp"
                android:layout_marginStart="6dp" />
        </LinearLayout>

    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>
