<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <!-- Fixed Header -->
    <RelativeLayout
        android:id="@+id/layoutChatHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp"
        android:background="?attr/colorSurface"
        android:elevation="3dp"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btnBackChat"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_input_field"
            android:src="@drawable/ic_back"
            app:tint="?android:attr/textColorPrimary"
            android:layout_marginEnd="12dp"
            android:contentDescription="Atrás" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/btnBackChat"
            android:layout_toStartOf="@id/btnDirectChatMenu"
            android:layout_centerVertical="true"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvChatContactName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nombre Contacto"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="17sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvChatContactRole"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profesor • Matemáticas"
                android:textColor="?attr/colorPrimary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="1dp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnDirectChatMenu"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_more_vert"
            app:tint="?android:attr/textColorPrimary"
            android:contentDescription="Opciones del chat" />
    </RelativeLayout>

    <!-- Search Bar inside Chat (Collapsible / Toggleable) -->
    <LinearLayout
        android:id="@+id/layoutSearchContainer"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_below="@id/layoutChatHeader"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="?attr/colorSurface"
        android:paddingHorizontal="16dp"
        android:elevation="3dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_search"
            app:tint="?android:attr/textColorSecondary"
            android:contentDescription="Buscar"
            android:layout_marginEnd="10dp"/>

        <EditText
            android:id="@+id/etSearchChat"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="Buscar mensaje en este chat..."
            android:textSize="14sp"
            android:textColor="?android:attr/textColorPrimary"
            android:textColorHint="?android:attr/textColorSecondary"
            android:singleLine="true" />

        <ImageButton
            android:id="@+id/btnCloseSearch"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            app:tint="?android:attr/textColorSecondary"
            android:contentDescription="Cerrar búsqueda" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChatMessages"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/layoutSearchContainer"
        android:layout_above="@id/layoutChatInput"
        android:padding="8dp"/>

    <LinearLayout
        android:id="@+id/layoutChatInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="?attr/colorSurface"
        android:elevation="4dp"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/etChatMessage"
            style="@style/Widget.Bootstrap.EditText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Escribe un mensaje privado..."
            android:textSize="14sp"
            android:padding="12dp"
            android:maxLines="4"
            android:background="@drawable/bg_input_field"
            android:textColor="?android:attr/textColorPrimary"
            android:textColorHint="?android:attr/textColorSecondary" />

        <ImageButton
            android:id="@+id/btnSendDirectMsg"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_circle_primary"
            android:src="@drawable/ic_send"
            app:tint="@color/white"
            android:scaleType="centerInside"
            android:padding="12dp"
            android:contentDescription="Enviar mensaje" />

    </LinearLayout>

</RelativeLayout>
