<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/input_bg"
        app:strokeWidth="1dp"
        app:strokeColor="@color/input_border">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Title & Close Header Row -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvDialogTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_toStartOf="@id/btnCloseDialog"
                    android:text="Crear Notificación"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnCloseDialog"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_close"
                    app:tint="?android:attr/textColorSecondary"
                    android:contentDescription="Cerrar" />
            </RelativeLayout>

            <!-- Subtitle -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Publica comunicados directos para la comunidad escolar."
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="14sp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="20dp" />

            <!-- Field 1: Título de la Notificación * -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Título de la Notificación"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" *"
                    android:textColor="@color/bs_danger"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_input_field"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp"
                android:layout_marginBottom="16dp">

                <EditText
                    android:id="@+id/etTitle"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:hint="Ej: Convocatoria Reunión General"
                    android:inputType="textCapSentences"
                    android:singleLine="true"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textColorHint="@color/input_hint"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- Field 2: Icono de la Notificación -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:text="Icono de la Notificación"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSelectedIconLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="Aviso general"
                    android:textColor="#38BDF8"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <!-- Horizontal Scroll of Icon Options -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:overScrollMode="never"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingVertical="4dp"
                    android:paddingHorizontal="2dp">

                    <!-- Icon Option 1: General (Megaphone) -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnIconGeneral"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_marginEnd="10dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#131D33"
                        app:strokeWidth="2dp"
                        app:strokeColor="#38BDF8"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?android:attr/selectableItemBackground">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_megaphone"
                            app:tint="#38BDF8"
                            android:contentDescription="General" />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Icon Option 2: Académico -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnIconAcademic"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_marginEnd="10dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#291F15"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/input_border"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?android:attr/selectableItemBackground">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_person"
                            app:tint="#F59E0B"
                            android:contentDescription="Académico" />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Icon Option 3: Alerta -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnIconAlert"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_marginEnd="10dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#0E242D"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/input_border"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?android:attr/selectableItemBackground">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_notification"
                            app:tint="#06B6D4"
                            android:contentDescription="Alerta" />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Icon Option 4: Sistema -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnIconSystem"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_marginEnd="10dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#1E1B2E"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/input_border"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?android:attr/selectableItemBackground">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_settings"
                            app:tint="#8B5CF6"
                            android:contentDescription="Sistema" />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Icon Option 5: Materias -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnIconSubject"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#0D281E"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/input_border"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?android:attr/selectableItemBackground">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_open_book"
                            app:tint="#10B981"
                            android:contentDescription="Materias" />
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>
            </HorizontalScrollView>

            <!-- Field 3: Mensaje / Contenido de la Notificación * -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mensaje / Contenido de la Notificación"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" *"
                    android:textColor="@color/bs_danger"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:background="@drawable/bg_input_field"
                android:orientation="horizontal"
                android:padding="14dp"
                android:layout_marginBottom="16dp">

                <EditText
                    android:id="@+id/etMessage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:hint="Escribe el mensaje detallado de la notificación..."
                    android:gravity="top|start"
                    android:inputType="textMultiLine"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textColorHint="@color/input_hint"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- Field 4: Destinatarios (Audiencia del canal) -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:text="Destinatarios"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="Audiencia del canal"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="12sp" />
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/btnSelectTarget"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_input_field"
                android:paddingHorizontal="14dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_alignParentStart="true"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/bg_circle_primary"
                        android:layout_marginEnd="8dp"/>

                    <TextView
                        android:id="@+id/tvSelectedTarget"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Destinatarios: [📢 General]"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"
                    android:src="@drawable/ic_chevron_right"
                    android:rotation="90"
                    app:tint="?android:attr/textColorSecondary"
                    android:contentDescription="Dropdown" />
            </RelativeLayout>

            <!-- Action Buttons: Cancel / Send -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancelDialog"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="Cancelar"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/input_border"
                    app:strokeWidth="1dp"
                    android:backgroundTint="#1D2738" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSendDialog"
                    style="@style/Widget.Bootstrap.Button.Primary"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Enviar"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    app:icon="@drawable/ic_send"
                    app:iconGravity="textStart"
                    app:iconSize="18dp"
                    app:iconTint="@color/white"
                    app:cornerRadius="12dp"
                    app:backgroundTint="?attr/colorPrimary"
                    app:elevation="0dp" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</ScrollView>
