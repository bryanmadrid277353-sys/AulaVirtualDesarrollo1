<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardSubjectGridItem"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/input_bg"
    app:strokeWidth="1dp"
    app:strokeColor="@color/input_border"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="14dp">

        <!-- Top Row: Icon Box on Left, Chevron on Right -->
        <FrameLayout
            android:id="@+id/iconSubjectBoxGrid"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_input_field"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true">

            <ImageView
                android:id="@+id/ivSubjectIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_open_book"
                app:tint="@color/accent_cyan"
                android:contentDescription="Materia" />
        </FrameLayout>

        <ImageView
            android:id="@+id/btnChevronRight"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_chevron_right"
            app:tint="?android:attr/textColorSecondary"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:contentDescription="Gestionar" />

        <!-- Info Column: Title, Subtitle, Schedule -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/iconSubjectBoxGrid"
            android:layout_marginTop="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSubjectTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end"
                tools:text="Matemáticas 5º Grado" />

            <TextView
                android:id="@+id/tvSubjectSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/entity_materia"
                android:textSize="12sp"
                android:layout_marginTop="3dp"
                android:maxLines="2"
                android:ellipsize="end"
                tools:text="Aula Magna A-1 • Sección 01" />

            <TextView
                android:id="@+id/tvScheduleDays"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/entity_instalacion"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginTop="6dp"
                android:maxLines="2"
                android:ellipsize="end"
                tools:text="Martes, Jueves\n(07:30 AM - 09:00 AM)" />
        </LinearLayout>

    </RelativeLayout>
</androidx.cardview.widget.CardView>
