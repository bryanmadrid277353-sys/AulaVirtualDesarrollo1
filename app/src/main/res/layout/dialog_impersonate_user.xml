<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/input_bg"
    app:strokeWidth="1dp"
    app:strokeColor="@color/input_border">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Title -->
        <TextView
            android:id="@+id/tvImpersonateTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Acceder como encargado del estudiante"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp"
            tools:text="Acceder como encargado del estudiante" />

        <!-- User Summary Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#162235"
            app:strokeWidth="1dp"
            app:strokeColor="#233550">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="14dp">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_circle_primary"
                    android:layout_marginEnd="12dp">

                    <TextView
                        android:id="@+id/tvUserInitials"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        tools:text="BM"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvUserName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bryan Antonio Madrid Cortez"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="Bryan Antonio Madrid Cortez" />

                    <TextView
                        android:id="@+id/tvUserCarnet"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ENC1444444"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="13sp"
                        android:layout_marginTop="2dp"
                        tools:text="ENC1444444" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Description -->
        <TextView
            android:id="@+id/tvImpersonateQuestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="¿Deseas ingresar a la aplicación utilizando el perfil y menú de Bryan Antonio Madrid Cortez?"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="14sp"
            android:layout_marginBottom="16dp"
            tools:text="¿Deseas ingresar a la aplicación utilizando el perfil y menú de Bryan Antonio Madrid Cortez?" />

        <!-- Notice Box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_shield_check"
                app:tint="?attr/colorPrimary"
                android:contentDescription="Admin"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tvNoticeText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Opción exclusiva del Administrador. No se modificará el registro del encargado."
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="12sp"
                tools:text="Opción exclusiva del Administrador. No se modificará el registro del encargado." />
        </LinearLayout>

        <!-- Buttons Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancel"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="52dp"
                android:layout_marginEnd="8dp"
                android:text="Cancelar"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                app:cornerRadius="12dp"
                app:strokeColor="@color/input_border"
                app:strokeWidth="1dp"
                android:backgroundTint="@color/input_bg" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAcceder"
                style="@style/Widget.Bootstrap.Button.Primary"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:text="Acceder"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                app:cornerRadius="12dp"
                app:elevation="0dp" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
